# Create a TMDB account, then copy your API Read Access Token here.
# Keep this token server-side. Do not expose it with NEXT_PUBLIC_.
TMDB_READ_TOKEN=your_tmdb_api_read_access_token

# Default provider region used on detail pages.
TMDB_REGION=ET

# Enables rights-filtered Ethiopian movie discovery from the approved channel allowlist.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Public production URL used as the YouTube upload-notification callback.
NEXT_PUBLIC_SITE_URL=https://your-addismovie-domain.com

# Long random values. Keep both server-side.
YOUTUBE_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
YOUTUBE_SYNC_SECRET=replace_with_a_long_random_subscription_secret
